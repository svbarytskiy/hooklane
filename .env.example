# App
NODE_ENV=development
PORT=3000

# Backend API
API_URL=http://localhost:3000
WEB_URL=http://localhost:5173
# Frontend
VITE_API_URL=http://localhost:3000

# Local Supabase
# Run `supabase start` and copy these values from the CLI output.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=replace-with-local-anon-key
SUPABASE_SERVICE_ROLE_KEY=replace-with-local-service-role-key

# Vite exposes only variables prefixed with VITE_ to the browser.
# Never put SUPABASE_SERVICE_ROLE_KEY in frontend env.
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=replace-with-local-anon-key

# Database
# Local Supabase Postgres usually runs on port 54322.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# Generates encrypted storage for dynamic inbound webhook signing secrets.
# Create a real value locally; never commit it or expose it to the frontend.
WEBHOOK_SECRETS_ENCRYPTION_KEY=replace-with-base64-encoded-32-byte-key
# Reject signed requests older/newer than this many seconds.
WEBHOOK_SIGNATURE_TOLERANCE_SECONDS=300
# Baseline public-ingress protection per endpoint and client IP.
WEBHOOK_RATE_LIMIT_MAX_REQUESTS=60
WEBHOOK_RATE_LIMIT_WINDOW_SECONDS=60
# Delivery history policy. Payloads older than this are hidden from the API.
WEBHOOK_PAYLOAD_RETENTION_DAYS=30
WEBHOOK_REDACT_KEYS=password,token,secret,authorization,api_key,apikey,access_token,refresh_token,client_secret

# Stripe
# Use test mode keys for local development.
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me

# Stripe price IDs from the Stripe Dashboard in test mode.
STRIPE_CREDITS_PRICE_ID=price_replace_me
STRIPE_PRO_MONTHLY_PRICE_ID=price_replace_me

# Manual Stripe Checkout test card:
# Number: 4242 4242 4242 4242
# Expiration: any future date, for example 12/34
# CVC: any three digits

REDIS_URL=redis://127.0.0.1:6380
WORKFLOW_QUEUE_CONCURRENCY=1
WORKFLOW_MAX_ATTEMPTS=3
WORKFLOW_BACKOFF_DELAY_MS=1000
WORKFLOW_BACKOFF_MAX_DELAY_MS=300000
WORKFLOW_BACKOFF_JITTER_RATIO=0.2
WORKFLOW_COMPLETED_RETENTION=1000
WORKFLOW_FAILED_RETENTION=5000
